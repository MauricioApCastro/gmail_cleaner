# --- Padrão MAC Tecnology ---
# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Ambientes virtuais
venv/
.venv/
env/

# Build (PyInstaller) — publique executáveis em Releases, não no repositório
build/
dist/
*.exe

# Segredos e credenciais — nunca versionar
.env
*.env
credentials*.json
client_secret*.json
token*.json
*.pem
*.key

# Logs e dados locais
*.log
*.sqlite3
*.db

# Sistema / editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- Regras específicas do projeto ---
# Python cache and bytecode
__pycache__/
**/__pycache__/
*.pyc
*.py[cod]
*.pyo

# Virtual environments
.venv/
.venv*/
venv/
env/

# Local environment files
.env
.env.*

# Local Gmail credentials and tokens
credentials/*
credentials/client_secret.json
credentials/token.json
!credentials/.gitkeep
token.json
**/token.json
*.secret.json
logs/
*.log
src/logs/
src/data/accounts/*
src/data/exceptions/*
src/data/history/*
src/data/history/*.jsonl
src/data/cache/*
!src/data/accounts/.gitkeep
!src/data/exceptions/.gitkeep
!src/data/history/.gitkeep
!src/data/cache/.gitkeep

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db
