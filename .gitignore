# Python cache and bytecode
__pycache__/
**/__pycache__/
*.pyc
*.py[cod]
*.pyo

# Virtual environments
.venv/
.venv*/
venv/
env/

# Local environment files
.env
.env.*

# Local Gmail credentials and tokens
credentials/*
credentials/client_secret.json
credentials/token.json
!credentials/.gitkeep
token.json
**/token.json
*.secret.json
logs/
*.log
src/logs/
src/data/accounts/*
src/data/exceptions/*
src/data/history/*
src/data/history/*.jsonl
src/data/cache/*
!src/data/accounts/.gitkeep
!src/data/exceptions/.gitkeep
!src/data/history/.gitkeep
!src/data/cache/.gitkeep

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db
