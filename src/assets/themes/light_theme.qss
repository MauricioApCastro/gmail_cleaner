QMainWindow {
    background: #F6F8FB;
    color: #071A3D;
    font-family: "Segoe UI", Arial, sans-serif;
}

#appRoot {
    background: #F6F8FB;
}

QLabel {
    color: #071A3D;
}

#header {
    background: transparent;
    min-height: 214px;
}

#brandIcon {
    background: #EFF6FF;
    border: 2px solid #1677FF;
    border-radius: 14px;
    color: #1677FF;
    font-size: 32px;
    font-weight: 800;
    min-height: 54px;
    max-height: 54px;
    min-width: 54px;
    max-width: 54px;
}

#brandTitle {
    font-size: 36px;
    font-weight: 850;
}

#brandSlogan {
    color: #64748B;
    font-size: 15px;
    font-weight: 700;
}

#brandByline {
    color: #64748B;
    font-size: 16px;
    font-style: italic;
}

#contentPanel {
    background: #FFFFFF;
    border: 1px solid #DDE5F0;
    border-radius: 14px;
}

#navigation {
    background: #FFFFFF;
    border-bottom: 1px solid #DDE5F0;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    min-height: 60px;
}

#tabButton,
#tabActive {
    background: transparent;
    border: 0;
    border-bottom: 3px solid transparent;
    border-radius: 0;
    color: #64748B;
    font-size: 15px;
    font-weight: 600;
    min-height: 58px;
    padding: 0 10px;
}

#tabButton:hover {
    background: #F6F8FB;
    color: #1677FF;
}

#tabActive {
    background: #FFFFFF;
    border-bottom: 3px solid #1677FF;
    color: #1677FF;
}

#heroTitle {
    color: #071A3D;
    font-size: 32px;
    font-weight: 800;
}

#heroSubtitle {
    color: #64748B;
    font-size: 16px;
    line-height: 1.35;
}

#analysisCenter {
    background: transparent;
    max-width: 1180px;
}

#analysisSearchBar {
    background: #FFFFFF;
    border: 1px solid #DDE5F0;
    border-radius: 14px;
    min-height: 54px;
    min-width: 980px;
    max-width: 980px;
}

#analysisSearchIcon {
    color: #64748B;
    font-size: 26px;
    min-width: 26px;
}

#analysisSearchInput {
    background: transparent;
    border: 0;
    color: #071A3D;
    font-size: 15px;
    min-height: 48px;
    padding: 0 10px;
}

#analysisSearchInput:hover,
#analysisSearchInput:focus {
    border: 0;
}

#analysisActionCard {
    background: #FFFFFF;
    border: 1px solid #DDE5F0;
    border-radius: 16px;
    min-width: 330px;
    max-width: 360px;
}

#analysisActionCard[tone="blue"] {
    background: #F8FBFF;
    border: 1px solid #BFDBFE;
}

#analysisActionCard[tone="green"] {
    background: #F5FFF9;
    border: 1px solid #BBF7D0;
}

#analysisActionCard[tone="orange"] {
    background: #FFF8F1;
    border: 1px solid #FED7AA;
}

#analysisActionIcon {
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 28px;
    font-size: 26px;
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
}

#analysisActionCard[tone="green"] #analysisActionIcon {
    background: #DCFCE7;
    border: 1px solid #86EFAC;
}

#analysisActionCard[tone="orange"] #analysisActionIcon {
    background: #FFEDD5;
    border: 1px solid #FDBA74;
}

#analysisActionTitle {
    color: #071A3D;
    font-size: 17px;
    font-weight: 800;
}

#analysisActionText {
    color: #64748B;
    font-size: 13px;
    line-height: 1.35;
}

#analysisCardButtonBlue,
#analysisCardButtonGreen,
#analysisCardButtonOrange {
    background: #FFFFFF;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 800;
    min-height: 34px;
}

#analysisCardButtonBlue {
    border: 1px solid #BFDBFE;
    color: #1677FF;
}

#analysisCardButtonGreen {
    border: 1px solid #86EFAC;
    color: #16A34A;
}

#analysisCardButtonOrange {
    border: 1px solid #FDBA74;
    color: #F97316;
}

QLineEdit {
    background: #FFFFFF;
    border: 1px solid #DDE5F0;
    border-radius: 10px;
    color: #071A3D;
    font-size: 15px;
    min-height: 42px;
    padding: 0 14px;
    selection-background-color: #BFDBFE;
    selection-color: #0F172A;
}

QComboBox {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    color: #0F172A;
    font-size: 14px;
    min-height: 36px;
    padding: 0 12px;
}

QLineEdit:hover,
QSpinBox:hover,
QComboBox:hover {
    border: 1px solid #0D6EFD;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 1px solid #0D6EFD;
}

QSpinBox {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    color: #0F172A;
    font-size: 14px;
    min-height: 36px;
    padding: 0 10px;
}

QPushButton {
    border: 0;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    min-height: 42px;
    padding: 0 18px;
}

#heroButton {
    background: #1677FF;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    min-height: 48px;
    min-width: 170px;
    padding: 0 18px;
}

#primaryButton {
    background: #1677FF;
    color: #FFFFFF;
}

#secondaryButton {
    background: #F6FAFF;
    border: 1px solid #DDE5F0;
    color: #1677FF;
}

#dangerButton {
    background: #E5252A;
    color: #FFFFFF;
}

#heroButton:hover,
#primaryButton:hover {
    background: #0B66E4;
}

#secondaryButton:hover {
    background: #DBEAFE;
}

#dangerButton:hover {
    background: #C81E24;
}

QPushButton:disabled {
    background: #E2E8F0;
    border: 1px solid #E2E8F0;
    color: #94A3B8;
}

#summaryCard,
#pageCard {
    background: #FFFFFF;
    border: 1px solid #DDE5F0;
    border-radius: 14px;
}

#summaryCard {
    max-width: 900px;
}

#summaryTitleIcon {
    color: #1677FF;
    font-size: 22px;
    font-weight: 900;
}

#summaryTitle,
#sectionTitle,
#pageSectionTitle {
    color: #071A3D;
    font-size: 18px;
    font-weight: 750;
}

#pageSectionTitle {
    font-size: 20px;
}

#horizontalRule,
#metricDivider {
    background: #DDE5F0;
    border: 0;
}

#summaryMetric {
    background: transparent;
    border: 0;
}

#metricIcon {
    font-size: 24px;
    font-weight: 800;
}

#summaryMetric[tone="blue"] #metricIcon {
    color: #1677FF;
}

#summaryMetric[tone="green"] #metricIcon {
    color: #16A34A;
}

#summaryMetric[tone="orange"] #metricIcon {
    color: #F97316;
}

#summaryMetric[tone="purple"] #metricIcon {
    color: #7C3AED;
}

#metricValue {
    color: #071A3D;
    font-size: 24px;
    font-weight: 800;
}

#metricTitle {
    color: #334155;
    font-size: 14px;
}

#footer {
    background: transparent;
    min-height: 46px;
}

#footerText {
    color: #334155;
    font-size: 15px;
    font-weight: 700;
}

#footerHintText {
    color: #64748B;
    font-size: 14px;
}

#accountBadge {
    border-radius: 16px;
    font-size: 14px;
    font-weight: 700;
    padding: 6px 18px;
}

#accountPanelBadge {
    border-radius: 12px;
    font-size: 16px;
    font-weight: 750;
    padding: 8px 14px;
}

#accountBadge[state="connected"] {
    background: #DCFCE7;
    border: 1px solid #86EFAC;
    color: #166534;
}

#accountPanelBadge[state="connected"] {
    background: #DCFCE7;
    border: 1px solid #86EFAC;
    color: #166534;
}

#accountBadge[state="disconnected"] {
    background: #FEF2F2;
    border: 1px solid #FCA5A5;
    color: #B91C1C;
}

#accountPanelBadge[state="disconnected"] {
    background: #FEE2E2;
    border: 1px solid #FCA5A5;
    color: #991B1B;
}

#footerIcon,
#footerSeparator {
    color: #94A3B8;
    font-size: 16px;
}

#statusDot {
    background: #94A3B8;
    border-radius: 10px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

#statusDot[state="offline"],
#statusDot[state="idle"] {
    background: #94A3B8;
}

#statusDot[state="connected"],
#statusDot[state="done"] {
    background: #16A34A;
}

#statusDot[state="searching"] {
    background: #1677FF;
}

#statusDot[state="error"] {
    background: #E5252A;
}

#mutedText {
    color: #475569;
    font-size: 15px;
}

#fieldLabel {
    color: #334155;
    font-size: 13px;
    font-weight: 700;
}

#tableFilters {
    background: transparent;
}

#tableFilter {
    max-width: 160px;
    min-width: 130px;
}

QCheckBox {
    color: #334155;
    font-size: 14px;
    font-weight: 600;
    spacing: 8px;
}

QCheckBox::indicator {
    background: #FFFFFF;
    border: 1px solid #94A3B8;
    border-radius: 4px;
    height: 16px;
    width: 16px;
}

QCheckBox::indicator:checked {
    background: #16A34A;
    border: 1px solid #16A34A;
}

QProgressBar {
    background: #E2E8F0;
    border: 0;
    border-radius: 6px;
    min-height: 10px;
}

QProgressBar::chunk {
    background: #1677FF;
    border-radius: 6px;
}

QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #F6F8FB;
    border: 1px solid #DDE5F0;
    border-radius: 12px;
    color: #071A3D;
    gridline-color: #DDE5F0;
    font-size: 13px;
    selection-background-color: #DBEAFE;
    selection-color: #0F172A;
}

QTableWidget::item {
    padding: 10px;
}

#selectionIndicator {
    background: transparent;
    color: #166534;
    font-size: 15px;
    font-weight: 800;
}

QHeaderView::section {
    background: #F1F5F9;
    border: 0;
    border-right: 1px solid #E2E8F0;
    color: #475569;
    font-size: 12px;
    font-weight: 800;
    min-height: 40px;
    padding: 8px;
}

QMessageBox {
    background: #FFFFFF;
    color: #0F172A;
}

QMessageBox QLabel {
    color: #0F172A;
    font-size: 14px;
}
