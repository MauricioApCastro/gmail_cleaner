QMainWindow {
    background: #f8fafd;
    color: #202124;
    font-family: "Google Sans", "Segoe UI", Arial, sans-serif;
}

#appRoot {
    background: #f8fafd;
}

#sidebar {
    background: #ffffff;
    border-right: 1px solid #dadce0;
}

#logo {
    color: #202124;
    font-size: 24px;
    font-weight: 800;
}

#content {
    background: #f8fafd;
}

#pageTitle {
    color: #202124;
    font-size: 34px;
    font-weight: 800;
}

#pageSubtitle,
#fieldLabel,
#statTitle,
#statusText {
    color: #5f6368;
    font-size: 13px;
    font-weight: 650;
}

QLabel {
    color: #3c4043;
}

#sectionTitle {
    color: #202124;
    font-size: 16px;
    font-weight: 800;
}

#panel,
#statCard {
    background: #ffffff;
    border: 1px solid #dadce0;
    border-radius: 14px;
}

#statCard:hover,
#panel:hover {
    border: 1px solid #4285f4;
}

#statAccent {
    background: #4285f4;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    max-width: 46px;
}

#statValue {
    color: #202124;
    font-size: 36px;
    font-weight: 850;
}

#statusPill {
    background: #ffffff;
    border: 1px solid #dadce0;
    border-radius: 18px;
}

#statusDot {
    background: #9aa0a6;
    border-radius: 5px;
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
}

#statusDot[state="offline"],
#statusDot[state="idle"] {
    background: #9aa0a6;
}

#statusDot[state="connected"],
#statusDot[state="done"] {
    background: #34a853;
}

#statusDot[state="searching"] {
    background: #4285f4;
}

#statusDot[state="error"] {
    background: #ea4335;
}

QPushButton {
    border: 0;
    border-radius: 10px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 750;
    min-height: 42px;
    padding: 0 18px;
}

#primaryButton {
    background: #4285f4;
    color: #ffffff;
}

#primaryButton:hover {
    background: #1a73e8;
}

#primaryButton:pressed {
    background: #185abc;
}

#dangerButton {
    background: #ea4335;
    color: #ffffff;
}

#dangerButton:hover {
    background: #d93025;
}

#dangerButton:pressed {
    background: #b3261e;
}

QPushButton:disabled {
    background: #e8eaed;
    color: #9aa0a6;
}

#navButton,
#navButtonActive,
#themeButton {
    background: transparent;
    color: #3c4043;
    min-height: 42px;
    padding: 0 14px;
    text-align: left;
}

#navButton:hover,
#themeButton:hover {
    background: #f1f3f4;
    color: #202124;
}

#navButtonActive {
    background: #e8f0fe;
    color: #1967d2;
    border-left: 4px solid #4285f4;
}

QLineEdit {
    background: #ffffff;
    border: 1px solid #dadce0;
    border-radius: 10px;
    color: #202124;
    font-size: 15px;
    min-height: 42px;
    padding: 0 14px;
    selection-background-color: #d2e3fc;
    selection-color: #202124;
}

QSpinBox {
    background: #ffffff;
    border: 1px solid #dadce0;
    border-radius: 10px;
    color: #202124;
    font-size: 14px;
    min-height: 36px;
    padding: 0 10px;
}

QCheckBox {
    color: #3c4043;
    font-size: 13px;
    font-weight: 650;
    spacing: 8px;
}

QCheckBox::indicator {
    background: #ffffff;
    border: 1px solid #9aa0a6;
    border-radius: 4px;
    height: 16px;
    width: 16px;
}

QCheckBox::indicator:checked {
    background: #34a853;
    border: 1px solid #34a853;
}

QLineEdit:hover,
QSpinBox:hover {
    border: 1px solid #4285f4;
}

QLineEdit:focus,
QSpinBox:focus {
    border: 1px solid #1a73e8;
}

QProgressBar {
    background: #f1f3f4;
    border: 1px solid #dadce0;
    border-radius: 8px;
    min-height: 10px;
}

QProgressBar::chunk {
    background: #4285f4;
    border-radius: 8px;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #f8fafd;
    border: 1px solid #dadce0;
    border-radius: 12px;
    color: #202124;
    gridline-color: #e8eaed;
    font-size: 13px;
    selection-background-color: #d2e3fc;
    selection-color: #202124;
}

QTableWidget::item {
    padding: 10px;
}

QTableWidget::item:hover {
    background: #f1f3f4;
}

QHeaderView::section {
    background: #f1f3f4;
    border: 0;
    border-right: 1px solid #dadce0;
    color: #5f6368;
    font-size: 12px;
    font-weight: 800;
    min-height: 42px;
    padding: 8px;
}

QMessageBox {
    background: #ffffff;
    color: #202124;
}

QMessageBox QLabel {
    color: #202124;
    font-size: 14px;
}
