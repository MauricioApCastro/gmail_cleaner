QMainWindow {
    background: #F8FAFC;
    color: #0F172A;
    font-family: "Segoe UI", Arial, sans-serif;
}

#appRoot {
    background: #F8FAFC;
}

QLabel {
    color: #0F172A;
}

#topBar {
    background: transparent;
    min-height: 34px;
}

#topTitle {
    color: #0F172A;
    font-size: 18px;
    font-weight: 600;
}

#header {
    background: transparent;
    min-height: 126px;
}

#brandTitle {
    font-size: 36px;
    font-weight: 850;
}

#brandSlogan {
    color: #334155;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

#brandByline {
    color: #475569;
    font-size: 16px;
    font-style: italic;
}

#securityBadge {
    background: transparent;
    border: 0;
}

#securityIcon {
    background: #16A34A;
    border-radius: 18px;
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 900;
    min-height: 36px;
    max-height: 36px;
    min-width: 36px;
    max-width: 36px;
}

#securityTitle {
    color: #16A34A;
    font-size: 20px;
    font-weight: 650;
}

#securityText {
    color: #0F172A;
    font-size: 14px;
}

#contentPanel {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

#navigation {
    background: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    min-height: 60px;
}

#tabButton,
#tabActive {
    background: transparent;
    border: 0;
    border-bottom: 3px solid transparent;
    border-radius: 0;
    color: #334155;
    font-size: 15px;
    font-weight: 600;
    min-height: 58px;
    padding: 0 10px;
}

#tabButton:hover {
    background: #F8FAFC;
    color: #0D6EFD;
}

#tabActive {
    background: #FFFFFF;
    border-bottom: 3px solid #0D6EFD;
    color: #0D6EFD;
}

#heroTitle {
    color: #0F172A;
    font-size: 30px;
    font-weight: 750;
}

#heroSubtitle {
    color: #475569;
    font-size: 16px;
    line-height: 1.35;
}

#searchRow {
    background: transparent;
    max-width: 620px;
    min-width: 0;
}

QLineEdit {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    color: #0F172A;
    font-size: 15px;
    min-height: 42px;
    padding: 0 14px;
    selection-background-color: #BFDBFE;
    selection-color: #0F172A;
}

QLineEdit:hover,
QSpinBox:hover {
    border: 1px solid #0D6EFD;
}

QLineEdit:focus,
QSpinBox:focus {
    border: 1px solid #0D6EFD;
}

QSpinBox {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    color: #0F172A;
    font-size: 14px;
    min-height: 36px;
    padding: 0 10px;
}

QPushButton {
    border: 0;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    min-height: 42px;
    padding: 0 18px;
}

#heroButton {
    background: #0D6EFD;
    border-radius: 9px;
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 700;
    min-height: 56px;
    min-width: 220px;
    padding: 0 24px;
}

#primaryButton {
    background: #0D6EFD;
    color: #FFFFFF;
}

#secondaryButton {
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    color: #0D6EFD;
}

#dangerButton {
    background: #DC2626;
    color: #FFFFFF;
}

#heroButton:hover,
#primaryButton:hover {
    background: #0B5ED7;
}

#secondaryButton:hover {
    background: #DBEAFE;
}

#dangerButton:hover {
    background: #B91C1C;
}

QPushButton:disabled {
    background: #E2E8F0;
    border: 1px solid #E2E8F0;
    color: #94A3B8;
}

#summaryCard,
#pageCard {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

#summaryCard {
    max-width: 900px;
}

#summaryTitleIcon {
    color: #0D6EFD;
    font-size: 22px;
    font-weight: 900;
}

#summaryTitle,
#sectionTitle,
#pageSectionTitle {
    color: #0F172A;
    font-size: 18px;
    font-weight: 750;
}

#pageSectionTitle {
    font-size: 20px;
}

#horizontalRule,
#metricDivider {
    background: #E2E8F0;
    border: 0;
}

#summaryMetric {
    background: transparent;
    border: 0;
}

#metricIcon {
    font-size: 24px;
    font-weight: 800;
}

#summaryMetric[tone="blue"] #metricIcon {
    color: #0D6EFD;
}

#summaryMetric[tone="green"] #metricIcon {
    color: #16A34A;
}

#summaryMetric[tone="orange"] #metricIcon {
    color: #F59E0B;
}

#summaryMetric[tone="purple"] #metricIcon {
    color: #7C3AED;
}

#metricValue {
    color: #0F172A;
    font-size: 24px;
    font-weight: 800;
}

#metricTitle {
    color: #0F172A;
    font-size: 14px;
}

#footer {
    background: transparent;
    min-height: 28px;
}

#footerText {
    color: #475569;
    font-size: 15px;
}

#footerIcon,
#footerSeparator {
    color: #94A3B8;
    font-size: 16px;
}

#statusDot {
    background: #94A3B8;
    border-radius: 8px;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
}

#statusDot[state="offline"],
#statusDot[state="idle"] {
    background: #94A3B8;
}

#statusDot[state="connected"],
#statusDot[state="done"] {
    background: #16A34A;
}

#statusDot[state="searching"] {
    background: #0D6EFD;
}

#statusDot[state="error"] {
    background: #DC2626;
}

#mutedText {
    color: #475569;
    font-size: 15px;
}

#fieldLabel {
    color: #334155;
    font-size: 13px;
    font-weight: 700;
}

QCheckBox {
    color: #334155;
    font-size: 14px;
    font-weight: 600;
    spacing: 8px;
}

QCheckBox::indicator {
    background: #FFFFFF;
    border: 1px solid #94A3B8;
    border-radius: 4px;
    height: 16px;
    width: 16px;
}

QCheckBox::indicator:checked {
    background: #16A34A;
    border: 1px solid #16A34A;
}

QProgressBar {
    background: #E2E8F0;
    border: 0;
    border-radius: 6px;
    min-height: 10px;
}

QProgressBar::chunk {
    background: #0D6EFD;
    border-radius: 6px;
}

QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    color: #0F172A;
    gridline-color: #E2E8F0;
    font-size: 13px;
    selection-background-color: #DBEAFE;
    selection-color: #0F172A;
}

QTableWidget::item {
    padding: 10px;
}

QHeaderView::section {
    background: #F1F5F9;
    border: 0;
    border-right: 1px solid #E2E8F0;
    color: #475569;
    font-size: 12px;
    font-weight: 800;
    min-height: 40px;
    padding: 8px;
}

QMessageBox {
    background: #FFFFFF;
    color: #0F172A;
}

QMessageBox QLabel {
    color: #0F172A;
    font-size: 14px;
}
